# ---- Azure OpenAI (chat model that powers the agent) ----
AZURE_OPENAI_ENDPOINT=https://your-aoai-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional: set an API key for local dev. Leave empty to use DefaultAzureCredential (managed identity).
AZURE_OPENAI_API_KEY=

# ---- ACA Sandbox (per-session isolated code execution) ----
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=my-rg
AZURE_SANDBOX_GROUP=my-sandbox-group
AZURE_REGION=eastus2

# ---- Sandbox tuning (optional) ----
SANDBOX_DISK=ubuntu
SANDBOX_CPU=1000m
SANDBOX_MEMORY=2048Mi
SANDBOX_AUTO_SUSPEND_SECONDS=300
